// The Apple Developer team that signs the app — the same team agentiz is signed with.
TEAM_ID=5K5GDFV386
// The same identifier as the Android application id. The two stores never compare them; keeping
// them equal is only so that "the Unitool app" is one string wherever it is looked up.
BUNDLE_ID=cx.m42.unitool
APP_NAME=Unitool
// The name under the icon on the Home Screen. Only what a person sees: the bundle, the executable,
// the scheme and CI all stay Unitool (APP_NAME), and a Swift module name cannot start with a digit.
DISPLAY_NAME=37tool
// Kotlin builds the simulator framework for Apple silicon only (iosSimulatorArm64, no iosX64), so a
// build for "any simulator" must not ask for an Intel slice the framework does not have.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64
// Automatic for a person at Xcode. The testflight lane of ios.yml signs by hand with an App Store
// profile, and writes that into Signing.xcconfig for the one run (scripts/ios-ci-signing.py). Set
// here rather than in the project, which would outrank this file.
CODE_SIGN_STYLE=Automatic
#include? "Signing.xcconfig"
