<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Must be present and true: Compose Multiplatform runs a PlistSanityCheck at startup and aborts
	  without it — the app installs and then dies with SIGABRT on the first tap (agentiz, BUILD-IOS.md).
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!--
	  The languages the host is written in. iOS intersects this with the person's own order before
	  answering NSLocale.preferredLanguages, which is what deviceLanguageTag() reads, and it is what
	  lists Unitool in Settings with a language of its own.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- unitool://activate?… and unitool://app/<id>/<path>, the same two shapes the Android intent filter takes. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unitool</string>
			</array>
		</dict>
	</array>
	<!--
	  Export compliance, the owner's answer (2026-10-05): yes, the app encrypts. The 2FA export uses
	  its own age (X25519, ChaCha20-Poly1305, RSA-OAEP): standard algorithms, in addition to iOS's.
	  Nothing is proprietary, and the app is not on the French store.
	  That is the case Apple's NO is for. The key's documentation says: "Set the value for this key
	  to NO … to indicate that your app … either uses no encryption, or only uses encryption that's
	  exempt from export compliance requirements". App Store Connect's table asks standard algorithms
	  only for the French declaration, and only when the app is on the French store. So nothing is
	  owed, and NO means App Store Connect stops asking at every upload (2026-10-06).
	  On the French store it would be YES, with ITSEncryptionExportComplianceCode from the approved
	  declaration. The testflight lane writes both in by itself once Apple issues that code.
	  YES without the code is refused at upload (ITMS-90592). Without the key, every build asks again.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Asked the first time someone taps "Scan QR code" in the 2FA app. Without this string iOS kills
	  the app the moment it opens the camera.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Unitool reads a QR code: the one a site shows when you set up two-factor sign-in, or an activation code that opens a tool. The picture is examined on the phone and is never saved or sent.</string>
	<!--
	  The 2FA app opens behind Face ID (note 06). A Face ID device kills an app that asks without this
	  string; the host refuses to offer the lock at all when it is missing, and a debug build crashes
	  on purpose so that the omission is found on the first run.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>The 2FA app opens only after Face ID confirms it is you. Unitool learns only yes or no.</string>
	<!--
	  Passwords in a computer's browser (passwords-browser D551): while Passwords is on screen and a
	  computer is paired, the phone listens in the Wi-Fi and announces itself over Bonjour. Without
	  NSBonjourServices iOS drops the announcement; without the description it never asks. The
	  system asks at the first pairing, not at install, because nothing listens before that.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>A computer you paired in Passwords finds this phone in your Wi-Fi to ask for a password. You confirm every one on the phone; nothing is sent until you do.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_unitool._tcp</string>
	</array>
	<!-- Data messages: a push that updates an app without drawing anything (13 §1). -->
	<key>FirebaseMessagingAutoInitEnabled</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
