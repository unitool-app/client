<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking and no tracking domains: nothing here identifies a person across apps or sites. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- What the app itself collects: nothing. Firebase Messaging ships a manifest of its own. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!--
	  UserDefaults is a "required reason" API. The host keeps its settings, the apps' storage and the
	  session snapshot there (Superizer's PrefsStorage) — CA92.1: accessed only by this app itself.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
