{
  "manifest_version": 3,
  "name": "Unitool",
  "short_name": "Unitool",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Unitool",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+L" } }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
