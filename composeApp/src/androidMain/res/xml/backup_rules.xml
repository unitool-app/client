<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (android:fullBackupContent). The app stores exactly one thing worth
  carrying to a new device — the chosen language and whether keys vibrate — and nothing that
  would be wrong on different hardware, so the preferences file is included and nothing else is.
-->
<full-backup-content>
    <include domain="sharedpref" path="cx.m42.unitool.settings.xml" />
    <!--
      Not included, so never in a backup: the SSH keyring's records, cx.m42.services.ssh.xml
      (ssh-new 03 §2, I10). An <exclude> would be plainer, but lint fails a release build on one
      outside an <include>; BackupRulesTest keeps these rules include-only instead.
    -->
</full-backup-content>
