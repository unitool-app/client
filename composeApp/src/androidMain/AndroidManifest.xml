<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permission: granted at install time, never prompts the user. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      The network, and the two things that use it: the converter's exchange-rate table, and Firebase
      Cloud Messaging.

      Repeated here even though `superizer:host` declares it and manifest merging would bring it in
      anyway. A permission that changes what this app may claim about itself in its store listing is
      not something to discover by reading the merged manifest in a build directory — the listing
      and play/PRIVACY.md are written against this line.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 13+. Asked for at runtime, and only when the person starts using an app that shows
      notifications (Superizer's push gate, .ai-notes/done/push-opt-in D419–D420) — never at first start.
      Refusable: nothing else in the app changes when it is denied.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The 2FA app's QR scanner (services/qr-scanner, which declares it too). Asked for at runtime,
      the first time someone taps "Scan QR code", and refusable: pasting the link still works. Frames
      are read on the device and dropped; only the text of the code comes back, and nothing is saved
      until the person taps Save.

      Not required hardware: without these two lines the permission would make Play hide the app
      from every device lacking a back camera with autofocus.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unitool"
        android:localeConfig="@xml/locales_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!--
          FCM does not start by itself (push-opt-in D421): no token is minted and Google hears nothing
          from this install until the person uses an app that takes pushes. Superizer's
          PushTransport.activate() turns it on then, and Firebase remembers that.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The two link shapes of 06, as one filter: `unitool://activate?…` carries a payload
              and may unlock a hidden app, `unitool://app/<id>/<path>` merely names one and may not
              (D25). Both arrive at the same place — MainActivity hands the URL to the route, and
              ActivationService is what decides which is which.

              singleTask so a second link reaches onNewIntent rather than stacking a second copy of
              the host on top of the first; the host is one process with one open app (D4).
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unitool" />
            </intent-filter>
        </activity>
    </application>

</manifest>
